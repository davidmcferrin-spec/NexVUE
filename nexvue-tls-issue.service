# /etc/systemd/system/nexvue-tls-issue.service
#
# One-shot Let's Encrypt issue/renew (TLS-ALPN-01 on :443). Started by
# Settings → Certificates or by nexvue-tls-renew.timer. Do not enable this
# unit on boot — it stops Apache while lego binds 443.
#
# The EXIT trap in nexvue-ops-tls.sh starts apache2 again. That start is
# time-boxed so a hung restart cannot sit in this unit until SIGKILL and
# leave issue.lock behind.

[Unit]
Description=NexVUE Let's Encrypt issue/renew (TLS-ALPN-01)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nexvue-ops-tls.sh run
# Stop Apache, lego, start Apache. 180s was short enough that a slow stop
# plus the challenge was SIGTERM'd and the lock was left busy.
TimeoutStartSec=10min
# Cleanup's Apache start is capped at 20s. Leave room for that before SIGKILL.
TimeoutStopSec=45
Nice=5

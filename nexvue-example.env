# NexVUE station-wide config — installed as /etc/nexvue/nexvue.env
#
# Sourced by nexvue-encode@.service AFTER the per-channel file, so values here
# override any legacy per-channel copies of the same key. setup.sh installs
# this file only when absent (never overwrites a live station config).
#
# IMPORTANT: this file is SOURCED by bash, so normal shell quoting rules apply.

# Channel count of the installed DeckLink card (input validation for
# INPUT_TYPE=decklink). Duo 2 / Duo 2 Mini = 4, Quad 2 = 8, original Duo = 2.
# Default: 8
MAX_DEVICES=8

# Encoder / Settings slots (0 .. MAX_CHANNELS-1). Default matches Quad 2
# DeckLink connectors (MAX_DEVICES=8). Raise only if you hand-edit extra
# channel .env files beyond the card (e.g. future SRT add-ons).
# Default: 8
MAX_CHANNELS=8

# Optional: Services → Update from repo. setup.sh writes /etc/nexvue/repo.path
# from the clone it was run in; set NEXVUE_REPO only to override that path.
# NEXVUE_REPO=/opt/NexVUE
# Branch to hard-reset to on Update (default main).
# NEXVUE_UPDATE_BRANCH=main

# Local auth (setup.sh / nexvue-auth-bootstrap.php writes these when missing):
# Long-lived MediaMTX publish+api JWT (RS256, verified via /nexvue-jwks.php).
# NEXVUE_PUBLISH_JWT=
# Optional station sync key for future portal push/pull (Bearer token).
# NEXVUE_SYNC_KEY=
# Optional From: address for forgot-password mail() attempts.
# NEXVUE_MAIL_FROM=nexvue@localhost
